	(gr_text "PCB MASTER NOTES\nProject: MT Drive / Pump Interface\nPCB Rev: A\nLayers: 4\nMaterial: FR-4\nThickness: 1.55 / 1.60 mm nominal\nFinish: HASL LF / ENIG according to order\nSolder mask: Green\nSilkscreen: White\nTarget manufacturer: xxxxx\nStatus: Prototype release candidate"
