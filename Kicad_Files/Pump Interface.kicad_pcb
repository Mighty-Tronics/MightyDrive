			(justify left bottom)
		)
	)
	(gr_text "DESIGN INTENT\nIPC Class 2\n5-36 V DC pump supply\n4 A/channel continuous\n16 A total board-level current envelope\nPWM up to 31 kHz\n3.3 V / 5 V MCU input compatible"
		(at 212 82 0)
		(layer "Dwgs.User")
		(uuid "71b26c74-2b9f-4464-9b2b-7dac65e6f727")
		(effects
